# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=  # Optional: custom OpenAI endpoint

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google ADK Backend Configuration (optional - for multi-agent system)
USE_ADK_BACKEND=false
ADK_BACKEND_URL=http://localhost:8080
GOOGLE_API_KEY=your_gemini_api_key_here

# Supabase service role key (server only, never NEXT_PUBLIC_). Needed to read
# readings by reading_id now that public SELECT is removed from RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
